# Local development defaults. Never use these secrets or endpoints in production.
# Select real providers and replace required PLACEHOLDER values for production.
NODE_ENV=development
APP_ROLE=all
PORT=3000
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
SHUTDOWN_TIMEOUT_MS=15000
BUSINESS_TIMEZONE=Asia/Kolkata
AUTH_PROVIDER=local
PAYMENTS_PROVIDER=fake
MAPS_PROVIDER=fake
STORAGE_PROVIDER=local
EMAIL_PROVIDER=smtp
PUSH_PROVIDER=fake
DATABASE_URL=postgres://app:app@localhost:5432/delivery
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=10000
REDIS_URL=redis://localhost:6379
LOCAL_JWT_SECRET=local-dev-only-change-me
AWS_REGION=ap-south-1
COGNITO_CUSTOMER_POOL_ID=PLACEHOLDER
COGNITO_CUSTOMER_CLIENT_ID=PLACEHOLDER
COGNITO_WORKFORCE_POOL_ID=PLACEHOLDER
COGNITO_RIDER_CLIENT_ID=PLACEHOLDER
COGNITO_STORE_CLIENT_ID=PLACEHOLDER
COGNITO_ADMIN_CLIENT_ID=PLACEHOLDER
S3_MEDIA_BUCKET=PLACEHOLDER
S3_PRIVATE_BUCKET=PLACEHOLDER
S3_ENDPOINT=http://localhost:4566
CDN_BASE_URL=PLACEHOLDER
SES_FROM_ADDRESS=PLACEHOLDER
SMTP_URL=smtp://localhost:1025
FCM_SERVICE_ACCOUNT_JSON_SECRET=PLACEHOLDER
RAZORPAY_KEY_ID=PLACEHOLDER
RAZORPAY_KEY_SECRET=PLACEHOLDER
RAZORPAY_WEBHOOK_SECRET=PLACEHOLDER
OLA_MAPS_API_KEY=PLACEHOLDER
OLA_MAPS_BASE_URL=https://api.olamaps.io
OLA_MAPS_AUTOCOMPLETE_PATH=/places/v1/autocomplete
OLA_MAPS_DETAILS_PATH=/places/v1/details
OLA_MAPS_GEOCODE_PATH=/places/v1/geocode
OLA_MAPS_REVERSE_PATH=/places/v1/reverse-geocode
OLA_MAPS_DIRECTIONS_PATH=/routing/v1/directions
OLA_MAPS_MATRIX_PATH=/routing/v1/distanceMatrix/basic
OLA_MAPS_TIMEOUT_MS=3000
OLA_MAPS_BREAKER_FAILURES=5
OLA_MAPS_BREAKER_COOLDOWN_MS=30000
OLA_MAPS_MAX_ATTEMPTS=2
MAPS_CACHE_TTL_SECONDS=2592000
MAPS_MATRIX_TOP_K=5
RATE_LIMIT_DEFAULT_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_SEARCH_PER_MIN=30
RATE_LIMIT_LOCATION_PER_MIN=30
HTTP_BODY_LIMIT_BYTES=1048576
METRICS_BEARER_TOKEN=

# Optional migration credentials, otherwise DATABASE_URL is used.
# MIGRATION_DATABASE_URL=postgres://app:app@localhost:5432/delivery
PRIVATE_UPLOAD_MAX_BYTES=5242880
CATALOG_UPLOAD_MAX_BYTES=20971520
PRIVATE_UPLOAD_URL_TTL_SECONDS=300
PRIVATE_READ_URL_TTL_SECONDS=60

# Defaults to an absolute .local/private path under the working directory.
# LOCAL_PRIVATE_STORAGE_DIR=/absolute/path/to/private-media
# LOCAL_CATALOG_STORAGE_DIR=/absolute/path/to/catalog-media
COGNITO_TIMEOUT_MS=3000
COGNITO_BREAKER_FAILURES=5
COGNITO_BREAKER_COOLDOWN_MS=30000
