# Public Cognito settings. Use the rider app client, not a client secret or AWS credentials.
EXPO_PUBLIC_COGNITO_REGION=ap-southeast-2
EXPO_PUBLIC_COGNITO_CLIENT_ID=
# Local development discovers the Expo server's LAN address automatically.
# Change this port only if the local backend listens on a different one.
EXPO_PUBLIC_API_PORT=13080
# Optional explicit backend URL. Required for release builds; use HTTPS.
EXPO_PUBLIC_API_URL=
