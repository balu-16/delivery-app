cy: 'initial'. Either include it or remove the dependency array.",["333"],["334"],"React Hook useEffect has a missing dependency: 'load'. Either include it or remove the dependency array.",["335"],["336"],["337"],["338"],"React Hook useEffect has missing dependencies: 'load' and 'restoreDraft'. Either include them or remove the dependency array.",["339"],["340"],["341"],["342"],["343"],["344"],{"kind":"345","justification":"346"},{"kind":"345","justification":"346"},{"desc":"347","fix":"348"},{"kind":"345","justification":"346"},{"desc":"349","fix":"350"},{"kind":"345","justification":"346"},{"desc":"351","fix":"352"},{"kind":"345","justification":"346"},{"desc":"353","fix":"354"},{"kind":"345","justification":"346"},{"desc":"355","fix":"356"},{"kind":"345","justification":"346"},{"desc":"357","fix":"358"},{"kind":"345","justification":"346"},{"desc":"353","fix":"359"},{"kind":"345","justification":"346"},"directive","","Update the dependencies array to be: [refreshSignal, refreshVisible]",{"range":"360","text":"361"},"Update the dependencies array to be: [accountId, initial]",{"range":"362","text":"363"},"Update the dependencies array to be: [id, attemptRaw, load]",{"range":"364","text":"365"},"Update the dependencies array to be: [id, load]",{"range":"366","text":"367"},"Update the dependencies array to be: [load, restoreDraft, ticketId]",{"range":"368","text":"369"},"Update the dependencies array to be: [load]",{"range":"370","text":"371"},{"range":"372","text":"367"},[5565,5580],"[refreshSignal, refreshVisible]",[4536,4547],"[accountId, initial]",[3045,3061],"[id, attemptRaw, load]",[3273,3277],"[id, load]",[5302,5312],"[load, restoreDraft, ticketId]",[3254,3256],"[load]",[3008,3012]]