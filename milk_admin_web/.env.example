# ── Backend API ────────────────────────────────────────────────
# Target the NestJS backend proxies to in `npm run dev`.
# The SPA itself always calls same-origin /v1 (cookie auth + CSRF).
# Must match the server's PORT (server/.env runs it on :13080).
VITE_DEV_API_TARGET=http://localhost:13080

# No secrets belong here: auth is cookie-only (HttpOnly session cookie set by
# the backend) and the CSRF token is held in memory for the tab's lifetime.
