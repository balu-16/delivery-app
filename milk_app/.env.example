# Leave empty for local Expo LAN discovery; set an HTTPS URL for a remote or release API.
EXPO_PUBLIC_API_URL=
# Optional: override the backend port only when it differs from server/.env.
EXPO_PUBLIC_API_PORT=
EXPO_PUBLIC_AUTH_MODE=cognito
# These are public app-client settings, never an AWS access key or client secret.
EXPO_PUBLIC_COGNITO_REGION=ap-southeast-2
EXPO_PUBLIC_COGNITO_CLIENT_ID=
